#!/bin/bash
set -u
set -o pipefail
PATH="/usr/sbin:/usr/bin:/sbin:/bin"
export PATH
umask 027
TASK_RUN="/run/reverse-proxy-cert-deployer"
TASK_STATE="/var/lib/reverse-proxy-cert-deployer"
TASK_SCRIPT="${TRIM_APPDEST}/server/fnos-deployer-helper.js"
case "$(uname -m)" in
  x86_64) TASK_ARCH=x64 ;;
  aarch64) TASK_ARCH=arm64 ;;
  *) echo 'Unsupported deployment architecture' >&2; exit 1 ;;
esac
TASK_NODE="${TRIM_APPDEST}/deployment-runtime/${TASK_ARCH}/node"
TASK_PID="${TASK_RUN}/helper.pid"

check_process() {
  [ -f "${TASK_PID}" ] || return 1
  local pid
  read -r pid < "${TASK_PID}" || return 1
  case "${pid}" in ''|*[!0-9]*) return 1 ;; esac
  [ "${pid}" -gt 1 ] || return 1
  kill -0 "${pid}" 2>/dev/null || return 1
  local -a args
  mapfile -d '' -t args < "/proc/${pid}/cmdline" 2>/dev/null || return 1
  [ "${#args[@]}" -eq 2 ] && [ "${args[0]}" = "${TASK_NODE}" ] && [ "${args[1]}" = "${TASK_SCRIPT}" ]
}

safe_code() {
  local file="$1" current mode
  current="$(readlink -f "${file}")" || return 1
  [ -f "${current}" ] || return 1
  while [ "${current}" != "/" ]; do
    [ "$(stat -c '%u' "${current}")" = "0" ] || return 1
    mode="$(stat -c '%a' "${current}")" || return 1
    (( (8#${mode} & 8#002) == 0 )) || return 1
    # fnOS may add a named root ACL, widening the mask without granting others
    # access. Reject writable non-root ACL identities, not the mask itself.
    getfacl -cpn "${current}" 2>/dev/null | awk -F: -v gid="$(stat -c '%g' "${current}")" '
      /^default:/ { next }
      $1 == "user" && $2 != "" && $2 != "0" && $3 ~ /w/ { bad=1 }
      $1 == "group" && $3 ~ /w/ && (($2 == "" && gid != "0") || ($2 != "" && $2 != "0")) { bad=1 }
      END { exit bad }
    ' || return 1
    current="$(dirname "${current}")"
  done
}

check_conflict() {
  if [ -f "${TASK_PID}" ]; then
    local existing
    read -r existing < "${TASK_PID}" || return 1
    case "${existing}" in ''|*[!0-9]*) return 1 ;; esac
    if kill -0 "${existing}" 2>/dev/null && ! check_process; then
      echo 'Another deployment worker is active; stop the legacy helper first' >&2
      return 1
    fi
  fi
}

start_app() {
  [ "$(id -u)" = "0" ] || return 1
  getent group reverse-proxy >/dev/null || return 1
  for directory in "${TASK_RUN}" "${TASK_STATE}"; do
    if [ -e "${directory}" ] || [ -L "${directory}" ]; then
      [ ! -L "${directory}" ] && [ -d "${directory}" ] && [ "$(stat -c '%u' "${directory}")" = "0" ] || return 1
    fi
  done
  install -d -o root -g reverse-proxy -m 0750 "${TASK_RUN}" || return 1
  install -d -o root -g root -m 0700 "${TASK_STATE}" || return 1
  exec 9>"${TASK_RUN}/start.lock"
  flock -n 9 || { check_process && return 0; return 1; }
  check_conflict || return 1
  check_process && return 0
  if [ -S "${TASK_RUN}/control.sock" ]; then rm -f -- "${TASK_RUN}/control.sock"; fi
  for file in "${TASK_NODE}" "${TASK_SCRIPT}" "${TRIM_APPDEST}/server/lib/fnos-deployment-engine.js" "${TRIM_APPDEST}/server/package.json"; do
    safe_code "${file}" || { echo '部署助手文件权限不安全，拒绝启动' >&2; return 1; }
  done
  /usr/bin/env -i PATH="${PATH}" NODE_ENV=production "${TASK_NODE}" "${TASK_SCRIPT}" >> "${TASK_STATE}/service.log" 2>&1 &
  local pid=$!
  printf '%s\n' "${pid}" > "${TASK_PID}"
  for ((attempt=0; attempt<10; attempt++)); do
    kill -0 "${pid}" 2>/dev/null || return 1
    check_process && [ -S "${TASK_RUN}/control.sock" ] && return 0
    sleep 1
  done
  return 1
}

stop_app() {
  check_conflict || return 1
  if check_process; then
    local pid
    read -r pid < "${TASK_PID}"
    kill -TERM "${pid}" || return 1
    for ((attempt=0; attempt<10; attempt++)); do
      check_process || break
      sleep 1
    done
    # An interrupted transaction is recovered from the root-only journal.
    if check_process; then kill -KILL "${pid}" || return 1; fi
  fi
  if [ -S "${TASK_RUN}/control.sock" ]; then rm -f -- "${TASK_RUN}/control.sock"; fi
  if [ -f "${TASK_PID}" ]; then rm -f -- "${TASK_PID}"; fi
}

case "${1:-}" in
  start) start_app ;;
  stop) stop_app ;;
  status) check_process && exit 0 || exit 3 ;;
  *) exit 1 ;;
esac
