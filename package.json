{
  "name": "fnos-reverse-proxy",
  "version": "1.0.16",
  "description": "面向飞牛 fnOS 的易用型多协议反向代理原生应用",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5178",
    "dev:server": "node --watch backend/server.js",
    "start:local": "node scripts/start-local.mjs",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4178",
    "test": "npm --prefix backend test",
    "check": "npm run build && npm run test",
    "package:fpk": "node scripts/build-fpk.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@vitejs/plugin-react": "5.0.4",
    "bootstrap-icons": "^1.13.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "vite": "6.4.3"
  }
}
