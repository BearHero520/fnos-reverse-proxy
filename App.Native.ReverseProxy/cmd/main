#!/bin/bash
set -eu
export PATH=/usr/sbin:/usr/bin:/sbin:/bin
TASK_CMD="$(cd -- "$(dirname -- "$0")" && pwd -P)"
[ "$(id -u)" = 0 ] || exit 1
if ! getent group reverse-proxy >/dev/null; then groupadd --system reverse-proxy; fi
if ! id reverse-proxy >/dev/null 2>&1; then
  useradd --system --gid reverse-proxy --no-create-home --home-dir /nonexistent --shell /usr/sbin/nologin reverse-proxy
fi
run_service() {
  /usr/bin/setpriv --reuid reverse-proxy --regid reverse-proxy --init-groups \
    --inh-caps +net_bind_service --ambient-caps +net_bind_service \
    /bin/bash "${TASK_CMD}/service" "$1"
}
prepare_permissions() {
  local app data
  app="$(readlink -f "${TRIM_APPDEST}")"
  data="$(readlink -f "${TRIM_PKGVAR}")"
  [ -n "${app}" ] && [ "${app}" != / ] && [ -d "${app}" ] || return 1
  [ -n "${data}" ] && [ "${data}" != / ] && [ -d "${data}" ] && [ "${data}" != "${app}" ] || return 1
  [ "$(stat -c '%u' "${app}")" = 0 ] || return 1
  # fnOS upgrades retain named package-user ACLs on the code tree even after
  # changing lifecycle identity to root. Revoke writes before starting workers.
  setfacl -R -P -b -k "${app}"
  find "${app}" -xdev -type d -exec chmod 755 {} +
  find "${app}" -xdev -type f -exec chmod 644 {} +
  chmod 755 "${app}/deployment-runtime/x64/node" "${app}/deployment-runtime/arm64/node"
  (cd "${app}" && sha256sum --quiet -c "${TASK_CMD}/../config/deployment.sha256") || return 1
  # Preserve data ownership/content and private other-user permissions. Grant
  # only the service UID access, including files that fnOS reset to root:0700.
  setfacl -m u:reverse-proxy:rwx "${data}"
  if [ -e "${data}/data" ]; then
    [ ! -L "${data}/data" ] && [ -d "${data}/data" ] || return 1
    setfacl -R -P -m u:reverse-proxy:rwX "${data}/data"
  fi
  for file in service.log app.pid; do
    if [ -e "${data}/${file}" ] || [ -L "${data}/${file}" ]; then
      [ ! -L "${data}/${file}" ] && [ -f "${data}/${file}" ] || return 1
      setfacl -m u:reverse-proxy:rw "${data}/${file}"
    fi
  done
}
case "${1:-}" in
  start)
    # Runtime data is writable by the service; privileged code is root-owned.
    prepare_permissions
    if [ -e "${TRIM_APPDEST}/app.sock" ] && [ ! -L "${TRIM_APPDEST}/app.sock" ]; then
      echo 'Existing gateway socket must be stopped before migration' >&2; exit 1
    fi
    ln -sfn "${TRIM_PKGVAR}/app.sock" "${TRIM_APPDEST}/app.sock"
    /bin/bash "${TASK_CMD}/deployment" start || echo '内置部署服务未就绪，代理服务仍可启动' >&2
    run_service start
    ;;
  stop) run_service stop; /bin/bash "${TASK_CMD}/deployment" stop ;;
  status) run_service status ;;
  *) exit 1 ;;
esac
